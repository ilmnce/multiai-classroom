{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "name": "OmniRoute Local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "freemium": {
          "name": "Classroom Teacher (Claude/GPT priority combo)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 2000000,
            "input": 200000,
            "output": 64000
          }
        },
        "classroom-students": {
          "name": "Classroom Students (DeepSeek V4 Flash)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 164000,
            "input": 128000,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "omniroute/freemium",
  "small_model": "omniroute/classroom-students",
  "default_agent": "teacher",
  "subagent_depth": 1,
  "share": "disabled"
}
